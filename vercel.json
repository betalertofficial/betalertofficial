{
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/poll-triggers",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/sync-schedules",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/sync-results",
      "schedule": "0 10 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/old-path",
      "destination": "/new-path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
